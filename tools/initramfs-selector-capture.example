#!/bin/sh
# Read-only selector sample before udev; no executor or experiment assets.
case "${1:-}" in prereqs) exit 0;; esac
case " $(cat /proc/cmdline) " in
    *" kohak.selectors=read-only-once "*) ;; *) exit 0;;
esac
umask 077
volume=/run/kohak-selector-volume
out=/run/kohak-selector-capture
mounted=n
early_fail()
{
    echo "Kohak selector capture skipped: $*; no diagnostic module loaded" > /dev/console
    if [ "$mounted" = y ]; then umount "$volume" 2>/dev/null || :; fi
    exit 0
}
. /etc/kohak-selector-log.conf || early_fail 'log configuration missing'
modprobe nvme || early_fail 'storage unavailable'
mkdir -m 0700 "$volume" || early_fail 'mountpoint already exists'
count=0
logdev=
while [ "$count" -lt 40 ]; do
    logdev=$(blkid -U "$KOH_LOG_UUID" 2>/dev/null) && [ -b "$logdev" ] && break
    count=$((count+1))
    sleep 0.25
done
[ -n "$logdev" ] && [ -b "$logdev" ] || early_fail 'log volume not found'
mount -t vfat -o rw,sync,umask=0077,nodev,nosuid,noexec "$logdev" "$volume" || early_fail 'log mount failed'
mounted=y
diskout="$volume/KohakUnlockLogs/$KOH_CAPTURE_ID"
mkdir -m 0700 "$diskout" || early_fail 'capture image already used'
ln -s "$diskout" "$out" || early_fail 'RAM link exists'
exec 3>"$out/gate.log"
echo 'prepared-before-read-only-module' > "$out/status"
uname -r > "$out/kernel.txt"
cat /proc/cmdline > "$out/cmdline.txt"
cat /proc/uptime > "$out/start-uptime.txt"
echo "power_transition_requested=${KOH_POWER_REQUESTED:-normal-reboot}; actual_transition=not-verified" >&3
capture()
{
    [ "$(uname -r)" = '7.0.0-30-generic' ] || return 1
    case " $(cat /proc/cmdline) " in *" tu102_execute.execute=0 "*) ;; *) return 1;; esac
    for proc in /proc/[0-9]*/comm; do
        name=$(cat "$proc" 2>/dev/null) || continue
        case "$name" in *udevd*) echo 'REFUSED: udev running' >&3; return 1;; esac
    done
    for name in tu102_execute tu102_diag nvidia nvidia_drm nvidia_modeset nvidia_uvm nouveau nova_core nova_drm vfio_pci; do
        [ ! -d "/sys/module/$name" ] || { echo "REFUSED: $name loaded" >&3; return 1; }
    done
    dev=/sys/bus/pci/devices/0000:01:00.0
    [ -d "$dev" ] && [ ! -L "$dev/driver" ] || return 1
    for pair in vendor:0x10de device:0x1e07 subsystem_vendor:0x10de subsystem_device:0x12a4; do
        key=${pair%%:*}; expected=${pair#*:}
        actual=$(cat "$dev/$key") || return 1
        echo "$key=$actual" >&3
        [ "$actual" = "$expected" ] || return 1
    done
    echo 'driver_before_capture=unbound' >&3
    cp /etc/kohak-selector-manifest.json "$out/manifest.json" || return 1
    sha256sum -c /etc/kohak-selector.sha256 >&3 2>&1 || return 1
    sync -f "$out" || return 1
    insmod "/lib/modules/$(uname -r)/extra/tu102_diag.ko" \
        target=0000:01:00.0 selectors_only=1 >&3 2>&1
}
dmesg -w > "$out/kernel-live.log" 2>&1 &
reader=$!
loaded=0
capture || loaded=$?
echo "capture_status=$loaded; no firmware transaction requested" >&3
dmesg > "$out/kernel.log"
cat /proc/uptime > "$out/end-uptime.txt"
kill "$reader" 2>/dev/null || :
wait "$reader" 2>/dev/null || :
if [ "$loaded" -eq 0 ]; then
    echo 'read-only-capture-finished; offline validation required' > "$out/status"
else
    echo 'read-only-capture-failed-or-refused' > "$out/status"
fi
sync -f "$out"
mkdir -m 0700 /run/kohak-selector-ram && cp -a "$diskout/." /run/kohak-selector-ram/
# Close every file on the temporary FAT mount before unmounting it.
exec 3>&-
rm "$out"
mv /run/kohak-selector-ram "$out"
if ! umount "$volume"; then
    echo 'STOP: temporary log mount busy; power cycle to normal Ubuntu' > /dev/console
    while :; do /bin/sh </dev/console >/dev/console 2>&1; done
fi
echo 'Kohak selector capture finished; persistent logs saved; continuing normal boot.' > /dev/console
exit 0
